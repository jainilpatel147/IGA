# IGA Platform - Environment Variables
# Copy this file to .env and customize

# PostgreSQL Database
POSTGRES_USER=iga
POSTGRES_PASSWORD=iga_password
POSTGRES_DB=iga_db

# Backend Configuration
JWT_SECRET=your-super-secret-key-change-in-production
DEBUG=false

# Optional: External database URL (overrides individual vars)
# DATABASE_URL=postgresql://user:password@host:5432/database
